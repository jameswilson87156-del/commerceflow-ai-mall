VITE_MOBILE_API_BASE_URL=/api
VITE_MOBILE_ASSET_BASE_URL=/static/assets
VITE_MOBILE_RUNTIME_MODE=REAL_BACKEND
VITE_MOBILE_DEV_API_TARGET=http://127.0.0.1:8080

# Set OIDC only for a real/staging H5 build. No client secret belongs here.
VITE_COMMERCEFLOW_AUTH_MODE=SHOWCASE
VITE_COMMERCEFLOW_AUTH_ISSUER_URI=
VITE_COMMERCEFLOW_AUTH_CLIENT_ID=
VITE_COMMERCEFLOW_AUTH_AUDIENCE=
VITE_COMMERCEFLOW_AUTH_SCOPE=openid profile email
