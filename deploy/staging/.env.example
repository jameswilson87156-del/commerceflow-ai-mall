# Copy to deploy/staging/.env and replace every CHANGE_ME value before use.
# Existing private RDS/Tair endpoints; this Compose does not create databases.
COMMERCEFLOW_DB_URL=jdbc:mysql://CHANGE_ME_private_rds:3306/commerceflow_staging?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Shanghai
COMMERCEFLOW_DB_USERNAME=commerceflow_staging
COMMERCEFLOW_DB_PASSWORD=CHANGE_ME_mysql_application_password
COMMERCEFLOW_DB_MIGRATION_USERNAME=commerceflow_migrator
COMMERCEFLOW_DB_MIGRATION_PASSWORD=CHANGE_ME_mysql_migration_password
COMMERCEFLOW_REDIS_HOST=CHANGE_ME_private_redis
COMMERCEFLOW_REDIS_PORT=6379
COMMERCEFLOW_REDIS_PASSWORD=CHANGE_ME_redis_password
COMMERCEFLOW_REDIS_SSL_ENABLED=true
COMMERCEFLOW_RATE_LIMIT_HASH_SECRET=CHANGE_ME_rate_limit_identity_hmac_secret

# These two hostnames must resolve to the staging machine before --profile tls.
STAGING_ADMIN_HOST=admin.staging.example.com
STAGING_MOBILE_HOST=mall.staging.example.com
STAGING_HTTP_PORT=8088
STAGING_PUBLIC_HTTP_PORT=80
STAGING_PUBLIC_HTTPS_PORT=443
ACME_EMAIL=operator@example.com
COMMERCEFLOW_CORS_ALLOWED_ORIGINS=https://admin.staging.example.com,https://mall.staging.example.com

# OIDC is mandatory for staging/production. Register both redirect URIs in the
# provider: https://admin.staging.example.com/ and https://mall.staging.example.com/.
COMMERCEFLOW_AUTH_ISSUER_URI=https://id.example.com/realms/commerceflow
COMMERCEFLOW_AUTH_AUDIENCE=commerceflow-api
COMMERCEFLOW_AUTH_ROLES_CLAIM=roles
COMMERCEFLOW_AUTH_PRINCIPAL_CLAIM=sub
COMMERCEFLOW_AUTH_USERNAME_CLAIM=email
COMMERCEFLOW_AUTH_DISPLAY_NAME_CLAIM=name
COMMERCEFLOW_AUTH_USER_ID_CLAIM=
COMMERCEFLOW_AUTH_OPERATOR_ID_CLAIM=
COMMERCEFLOW_AUTH_OPERATOR_ROLES=operator,admin
COMMERCEFLOW_AUTH_AUTO_PROVISION_USERS=false
# Public browser client id only; never put a client secret in VITE_* variables.
VITE_ADMIN_AUTH_CLIENT_ID=CHANGE_ME_admin_public_client
VITE_MOBILE_AUTH_CLIENT_ID=CHANGE_ME_mobile_public_client
VITE_COMMERCEFLOW_AUTH_SCOPE=openid profile email

# The Java adapter can target OpenAI, DeepSeek or another OpenAI-compatible
# gateway. Inject the real key only at runtime; do not commit it here.
COMMERCEFLOW_AI_PROVIDER=OPENAI_COMPATIBLE
COMMERCEFLOW_AI_BASE_URL=https://api.deepseek.com
COMMERCEFLOW_AI_PATH=/v1/chat/completions
COMMERCEFLOW_AI_MODEL=deepseek-chat
COMMERCEFLOW_AI_API_KEY=CHANGE_ME_runtime_secret
COMMERCEFLOW_AI_PROVIDER_NAME=deepseek
COMMERCEFLOW_AI_CONNECT_TIMEOUT_MS=1500
COMMERCEFLOW_AI_READ_TIMEOUT_MS=8000
COMMERCEFLOW_AI_MAX_RETRIES=1
COMMERCEFLOW_AI_FALLBACK_ENABLED=false

# Kept for the runtime boundary contract; actual identity is OIDC above.
SHOWCASE_AUTHENTICATION_MODE=EXTERNAL
