MYSQL_DATABASE=commerceflow
MYSQL_USER=commerceflow
MYSQL_PASSWORD=changeme
MYSQL_PORT=3307
MALL_API_PORT=8080
AI_SERVICE_PORT=8000
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=5174
MOBILE_H5_HOST=127.0.0.1
MOBILE_H5_PORT=5173
SHOWCASE_ADMIN_ORIGIN=http://127.0.0.1:5174
SHOWCASE_MOBILE_ORIGIN=http://127.0.0.1:5173
COMMERCEFLOW_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5173
# Java provider: FASTAPI is the safe local Showcase default. OPENAI_COMPATIBLE,
# OPENAI, or DEEPSEEK use the server-side compatible adapter; never commit a key.
COMMERCEFLOW_AI_PROVIDER=FASTAPI
COMMERCEFLOW_AI_BASE_URL=
COMMERCEFLOW_AI_PATH=/v1/chat/completions
COMMERCEFLOW_AI_API_KEY=
COMMERCEFLOW_AI_MODEL=
COMMERCEFLOW_AI_PROVIDER_NAME=openai-compatible
COMMERCEFLOW_AI_CONNECT_TIMEOUT_MS=1500
COMMERCEFLOW_AI_READ_TIMEOUT_MS=8000
COMMERCEFLOW_AI_MAX_RETRIES=1
COMMERCEFLOW_AI_FALLBACK_ENABLED=true
# FastAPI's own provider remains deterministic Mock for the local Showcase.
AI_PROVIDER_MODE=MOCK
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_LIMIT=5
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_KEY_PREFIX=commerceflow:local:ai:rate:v1
AI_RATE_LIMIT_FAILURE_POLICY=FAIL_OPEN
AI_RATE_LIMIT_IDENTITY_HASH_SECRET=local-showcase-rate-limit-salt
# Explicit local/demo configuration for the reproducible Showcase only.
# Do not copy these demo identities into staging or production.
SHOWCASE_MODE=DEMO
SHOWCASE_DATA_SCOPE=LOCAL_SHOWCASE
SHOWCASE_AUTHENTICATION_MODE=DEMO_USER
SHOWCASE_DEMO_USER_ID=1
SHOWCASE_DEMO_USERNAME=demo@commerceflow.local
SHOWCASE_DEMO_DISPLAY_NAME=Demo Shopper
SHOWCASE_OPERATOR_AUTHENTICATION_MODE=DEMO_OPERATOR
SHOWCASE_DEMO_OPERATOR_ID=9001
SHOWCASE_DEMO_OPERATOR_USERNAME=operator@commerceflow.local
SHOWCASE_DEMO_OPERATOR_DISPLAY_NAME=Showcase Operator
COMMERCEFLOW_LEGACY_API_ENABLED=true
SHOWCASE_MOBILE_RUNTIME=H5_VERIFIED
SHOWCASE_NON_H5_RUNTIME=COMPILE_ONLY

PORTFOLIO_AI_API_KEY=
